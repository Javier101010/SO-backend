{
  "name": "servicio-tiendavirtual",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de la tienda virtual de artesanías (Express + TypeScript + MySQL)",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Javier101010/SO-backend.git"
  },
  "bugs": {
    "url": "https://github.com/Javier101010/SO-backend/issues"
  },
  "homepage": "https://github.com/Javier101010/SO-backend#readme",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "keywords": [
    "express",
    "typescript",
    "mysql",
    "api-rest",
    "tienda-virtual"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.21.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "volta": {
    "node": "24.21.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
